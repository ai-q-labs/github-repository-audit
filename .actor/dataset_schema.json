                "properties": {
                    "input": {
                        "label": "You asked for",
                        "format": "text"
                    },
                    "source": {
                        "label": "Came from",
                        "format": "text"
                    },
                    "packageName": {
                        "label": "Package Name",
                        "format": "text"
                    },
                    "registry": {
                        "label": "Registry",
                        "format": "text"
                    },
                    "riskLevel": {
                        "label": "Risk",
