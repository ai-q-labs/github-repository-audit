                    },
                    "riskLevel": {
                        "label": "Risk",
                        "format": "text"
                    },
                    "issueCodes": {
                        "label": "Findings",
                        "format": "array"
                    },
                    "resolvedRepo": {
                        "label": "Resolved Repo",
                        "format": "text"
                    },
                    "archived": {
                        "label": "Archived",
                        "format": "boolean"
                    },
                    "moved": {
                        "label": "Moved",
