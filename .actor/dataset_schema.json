            "title": "Overview",
            "transformation": {
                "fields": [
                    "input",
                    "source",
                    "packageName",
                    "registry",
                    "packageVersion",
                    "riskLevel",
                    "issueCodes",
                    "resolvedRepo",
                    "archived",
                    "moved",
                    "daysSinceLastPush",
                    "repoUrl"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "input": {
                        "label": "You asked for",
